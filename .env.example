# ==============================================================================
# Конфигурация SuperBot (.env)
# Внимание: Установите права 600 на этот файл: chmod 600 /opt/superbot/.env
# ==============================================================================

# Telegram Bot Credentials (получить у @BotFather)
TG_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# Ваш личный числовой Telegram ID (получить у @userinfobot)
# ВНИМАНИЕ: Бот будет отвечать ТОЛЬКО этому пользователю! Все остальные запросы сбрасываются.
TG_ADMIN_ID=5342950903

# Мост к Antigravity (локальный порт agy-pilot или headless агента)
ANTIGRAVITY_API_URL=http://localhost:43427

# Локальный HTTP API SuperBot (для отправки уведомлений и файлов из Antigravity)
LOCAL_API_PORT=43428

# Имена системных сервисов для cgroups и команд перезапуска
VPN_SERVICE_NAME=x-ui.service
AI_SERVICE_NAME=omniroute.service

# Базовый каталог для поиска файлов (команда /find)
ALLOWED_BASE_PATH=/

# ==============================================================================
# Telegram MTProto User API (Для Prgebish/mcp-telegram)
# Получить на https://my.telegram.org -> API development tools
# ==============================================================================
TG_APP_ID=12345678
TG_APP_HASH=0123456789abcdef0123456789abcdef

# ==============================================================================
# Google Workspace OAuth (Для google-mcp: Gmail & Calendar)
# Получить в Google Cloud Console: APIs & Services -> Credentials -> OAuth 2.0 Client IDs
# ==============================================================================
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4100/oauth2callback

# Запасные реквизиты почтовых ящиков (через Пароли приложений)
GMAIL_USER=shibayev2023@gmail.com
GMAIL_APP_PASSWORD=your_gmail_app_password
MAILRU_USER=shibayev2023@mail.ru
MAILRU_APP_PASSWORD=your_mailru_app_password
